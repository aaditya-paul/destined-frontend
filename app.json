{
  "expo": {
    "name": "Destined",
    "slug": "destined-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/destined_1024_logo.png",
    "scheme": "destinedfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "fonts": [
        {
          "fontFamily": "ZonaPro-Bold",
          "fontDefinitions": [
            {
              "path": "./assets/fonts/ZonaPro-Bold.otf",
              "weight": "700"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/destined_512_logo.png",
        "backgroundImage": "./assets/images/destined_512_logo.png",
        "monochromeImage": "./assets/images/destined_512_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aaditya_paul.destined"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/destined_48_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/destined_1024_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/ZonaPro-Bold.otf"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af30d67d-159f-4a97-9f39-5b893dff368e"
      }
    }
  }
}
